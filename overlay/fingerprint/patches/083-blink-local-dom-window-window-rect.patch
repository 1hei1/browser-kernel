+// MZ: 网页读到的窗口矩形（screenX/screenY/outerWidth/outerHeight）收进伪装屏幕，
+// 不会出现 outerWidth 大于 screen.width、或窗口落在伪装屏幕之外的组合
+// （真实屏幕更大、有第二块屏、或用户手动拖动/最大化时都会这样）。
+gfx::Rect MzReportedWindowRect(const gfx::Rect& real) {
+  int x = real.x();
+  int y = real.y();
+  int width = real.width();
+  int height = real.height();
+  if (!mz::fingerprint::ScreenHardwareFingerprint::
+          FitWindowRectToConfiguredScreen(&x, &y, &width, &height)) {
+    return real;
+  }
+  return gfx::Rect(x, y, width, height);
+}
