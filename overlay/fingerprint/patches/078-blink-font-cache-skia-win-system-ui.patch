+// MZ: system-ui 和 CSS 系统字体（menu / caption / status-bar）在 Windows 上取的是
+// 系统 UI 字体，跟着系统显示语言走：中文系统是 Microsoft YaHei UI、日文是 Yu Gothic UI。
+// 环境伪装成别的语言时，这里要换成该语言 Windows 的默认 UI 字体，否则一测就露出真实系统语言。
+// 这些字体 Windows 10/11 各语言版本都自带。
+static AtomicString MzSystemUiFamilyFor(const AtomicString& real_family) {
+  std::string language = mz::config::GetLanguage();
+  if (language.empty()) {
+    return real_family;
+  }
+  for (char& c : language) {
+    c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+  }
+  const char* family = "Segoe UI";
+  if (language.rfind("ja", 0) == 0) {
+    family = "Yu Gothic UI";
+  } else if (language.rfind("ko", 0) == 0) {
+    family = "Malgun Gothic";
+  } else if (language.rfind("zh", 0) == 0) {
+    const bool traditional = language.find("tw") != std::string::npos ||
+                             language.find("hk") != std::string::npos ||
+                             language.find("mo") != std::string::npos ||
+                             language.find("hant") != std::string::npos;
+    family = traditional ? "Microsoft JhengHei UI" : "Microsoft YaHei UI";
+  } else if (language.rfind("th", 0) == 0) {
+    family = "Leelawadee UI";
+  }
+  return AtomicString(family);
+}
