+// MZ: 属性不在 Error 对象自身上时，沿原型链查找，但不执行任何网页代码：
+// 遇到 Proxy、或网页自己定义的 getter 就放弃。原来直接 object->Get() 会触发
+// 原型上的 Proxy trap / getter，网页借 console.log(err) 就能判断 DevTools/CDP
+// 的 Runtime 域是否开启（自动化检测常用手法）。
+v8::MaybeLocal<v8::Value> getInheritedErrorProperty(
+    v8::Local<v8::Context> context, v8::Local<v8::Object> object,
+    v8::Local<v8::String> name) {
+  v8::Isolate* isolate = v8::Isolate::GetCurrent();
+  v8::Local<v8::Value> current = object->GetPrototype();
+  for (int depth = 0; depth < 64 && current->IsObject(); ++depth) {
+    if (current->IsProxy()) return v8::MaybeLocal<v8::Value>();
+    v8::Local<v8::Object> holder = current.As<v8::Object>();
+    v8::Local<v8::Value> descriptor;
+    if (!holder->GetOwnPropertyDescriptor(context, name).ToLocal(&descriptor)) {
+      return v8::MaybeLocal<v8::Value>();
+    }
+    if (descriptor->IsObject()) {
+      v8::Local<v8::Object> descriptorObject = descriptor.As<v8::Object>();
+      v8::Maybe<bool> hasGet = descriptorObject->HasOwnProperty(
+          context, toV8String(isolate, "get"));
+      if (hasGet.IsNothing()) return v8::MaybeLocal<v8::Value>();
+      if (!hasGet.FromJust()) {
+        return descriptorObject->Get(context, toV8String(isolate, "value"));
+      }
+      if (v8::debug::SideEffectCheckScope::IsActive(isolate)) {
+        return v8::MaybeLocal<v8::Value>();
+      }
+      v8::Local<v8::Value> getter;
+      if (!descriptorObject->Get(context, toV8String(isolate, "get"))
+               .ToLocal(&getter) ||
+          !getter->IsFunction() ||
+          !isBuiltinGetter(getter.As<v8::Function>())) {
+        return v8::MaybeLocal<v8::Value>();
+      }
+      return object->Get(context, name);
+    }
+    current = holder->GetPrototype();
+  }
+  return v8::MaybeLocal<v8::Value>();
+}
