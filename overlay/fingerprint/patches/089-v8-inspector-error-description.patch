+// MZ: 读取内置的 error.stack 会按需格式化调用栈，格式化时会调用网页设置的
+// Error.prepareStackTrace（或它的 getter）。没开 DevTools 时 console.log(err)
+// 不会碰 stack，开了就会——网页借此判断 CDP Runtime 是否开启。
+// 只看属性描述符，不执行任何网页代码；判断不了时按“有风险”处理。
+bool errorStackMayRunUserCode(v8::Local<v8::Context> context) {
+  v8::Isolate* isolate = v8::Isolate::GetCurrent();
+  v8::TryCatch tryCatch(isolate);
+  v8::Local<v8::Value> errorDescriptor;
+  if (!context->Global()
+           ->GetOwnPropertyDescriptor(context, toV8String(isolate, "Error"))
+           .ToLocal(&errorDescriptor) ||
+      !errorDescriptor->IsObject()) {
+    return true;
+  }
+  v8::Local<v8::Object> errorDescriptorObject =
+      errorDescriptor.As<v8::Object>();
+  v8::Maybe<bool> hasValue = errorDescriptorObject->HasOwnProperty(
+      context, toV8String(isolate, "value"));
+  if (hasValue.IsNothing() || !hasValue.FromJust()) return true;
+  v8::Local<v8::Value> errorConstructor;
+  if (!errorDescriptorObject->Get(context, toV8String(isolate, "value"))
+           .ToLocal(&errorConstructor) ||
+      !errorConstructor->IsObject() || errorConstructor->IsProxy()) {
+    return true;
+  }
+  v8::Local<v8::Value> prepareDescriptor;
+  if (!errorConstructor.As<v8::Object>()
+           ->GetOwnPropertyDescriptor(
+               context, toV8String(isolate, "prepareStackTrace"))
+           .ToLocal(&prepareDescriptor)) {
+    return true;
+  }
+  return !prepareDescriptor->IsUndefined();
+}
