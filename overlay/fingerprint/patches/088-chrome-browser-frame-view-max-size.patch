+gfx::Size BrowserFrameView::GetMaximumSize() const {
+#if BUILDFLAG(IS_WIN)
+  // MZ: Windows 最大化时窗口大小受 WM_GETMINMAXINFO 的 ptMaxTrackSize 限制，
+  // 这里给出伪装屏幕的大小（DIP），最大化、拖边框、Aero Snap 都不会超过它。
+  // 真实工作区不比伪装屏幕大时不限制，保持原生行为。
+  const int screen_width =
+      mz::fingerprint::ScreenHardwareFingerprint::GetConfiguredScreenWidth();
+  const int avail_height =
+      mz::fingerprint::ScreenHardwareFingerprint::GetConfiguredAvailHeight();
+  const views::Widget* widget = GetWidget();
+  if (screen_width > 0 && avail_height > 0 && widget &&
+      widget->GetNativeWindow()) {
+    const gfx::Rect work_area =
+        display::Screen::Get()
+            ->GetDisplayNearestWindow(widget->GetNativeWindow())
+            .work_area();
+    if (work_area.width() > screen_width ||
+        work_area.height() > avail_height) {
+      return gfx::Size(std::min(screen_width, work_area.width()),
+                       std::min(avail_height, work_area.height()));
+    }
+  }
+#endif
+  return FrameView::GetMaximumSize();
+}
