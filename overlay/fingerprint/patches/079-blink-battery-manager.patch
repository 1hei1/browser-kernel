 namespace blink {
 
 const char BatteryManager::kSupplementName[] = "BatteryManager";
 
+namespace {
+
+// MZ: 环境配置了指纹时，用每个环境固定的电池状态替换真实电池（真实值所有环境都一样，
+// 还会暴露宿主机是笔记本 / 台式机）。固定不变，所以之后也不会派发 levelchange 等事件。
+BatteryStatus MzBatteryStatus(const BatteryStatus& real) {
+  bool charging = true;
+  double level = 1.0;
+  double charging_seconds = 0;
+  double discharging_seconds = 0;
+  if (!mz::fingerprint::BrowserFingerprint::GetBatteryOverride(
+          &charging, &level, &charging_seconds, &discharging_seconds)) {
+    return real;
+  }
+  auto to_delta = [](double seconds) {
+    return std::isinf(seconds) ? base::TimeDelta::Max() : base::Seconds(seconds);
+  };
+  return BatteryStatus(charging, to_delta(charging_seconds),
+                       to_delta(discharging_seconds), level);
+}
+
+}  // namespace
